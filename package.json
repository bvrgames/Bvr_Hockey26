{
  "name": "bvr-hockey-26",
  "private": true,
  "version": "0.0.0",
  "description": "BVR Hockey 26 — arcade 5v5 hockey for Telegram Mini Apps (single-file WebGL2).",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs 8490",
    "check": "node tools/check.mjs",
    "smoke": "node tools/smoke.mjs",
    "smoke:chromium": "node tools/smoke.mjs --browser chromium",
    "smoke:webkit": "node tools/smoke.mjs --browser webkit",
    "play": "node tools/play.mjs",
    "browsers": "playwright install chromium webkit",
    "smoke:online": "node tools/smoke-online.mjs",
    "relay": "node tools/relay-mock.mjs 8787",
    "balance": "node tools/balance.mjs",
    "smoke:tg": "node tools/smoke-tg.mjs && node tools/smoke-tg.mjs --browser webkit",
    "smoke:quality": "node tools/smoke-quality.mjs && node tools/smoke-quality.mjs --browser webkit"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "ws": "^8.22.0"
  }
}
